# Copy to .env.local for local development (never commit secrets)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Upstash Redis (persistent job state across serverless invocations)
# Get these from https://console.upstash.com → Redis → REST API
# Optional locally: without them an in-memory store is used.
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# QStash (Upstash message queue — for guaranteed background sync delivery)
# Get these from https://console.upstash.com → QStash tab
# Optional locally: without them the app falls back to a direct HTTP self-call.
# QSTASH_URL must match your account's region (copy it from the console, e.g. https://qstash-us-east-1.upstash.io).
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# Vercel Cron secret (protects the /api/cron/* endpoints)
# Generate any random string and set it in Vercel env settings
CRON_SECRET=your-cron-secret

# Optional: support address shown on the Privacy Policy and Terms of Service pages
NEXT_PUBLIC_CONTACT_EMAIL=

# Style engine (optional): the local model that rewrites text in the compiled style.
# Without a reachable model server the Style engine tab shows a notice and syncing works as before.
# LLM_PROVIDER: ollama (default) | openai (any OpenAI-compatible server: llama.cpp, vLLM, LM Studio) | anthropic (cloud, for testing prompts)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1
# Only for openai-compatible servers that require a key
# LLM_API_KEY=
# Only for LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
